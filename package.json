{
  "name": "sterling-data-generator",
  "version": "0.1.0",
  "description": "Sample data generator for IBM Sterling Order Management APIs (createOrder first). Generates XML/JSON payloads for preview and download - it never connects to an OMS instance.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "serve": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@faker-js/faker": "9.4.0",
    "express": "4.21.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.13.1",
    "fast-xml-parser": "4.5.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
